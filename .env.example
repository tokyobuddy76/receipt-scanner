# MISTRAL_API_KEY: Required for Mistral AI (Pixtral multimodal vision) receipt analysis.
# Obtain your key from https://console.mistral.ai
MISTRAL_API_KEY="MY_MISTRAL_API_KEY"

# GEMINI_API_KEY: Fallback API key if Mistral key is not configured.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
